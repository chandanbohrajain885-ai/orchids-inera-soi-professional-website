# ─── Supabase (optional — app works fully with localStorage only) ────
#
# Without Supabase: all data is saved in your browser's localStorage.
#   ✓ Works great for a single-device admin
#   ✗ Data does NOT transfer when you deploy to a new URL
#   ✗ Gallery images are local only
#
# To enable cloud sync across devices and deployments:
#   1. Create a free Supabase project → https://supabase.com
#   2. In your Supabase SQL editor, run:
#
#   CREATE TABLE site_config (
#     id int8 PRIMARY KEY DEFAULT 1,
#     data jsonb NOT NULL
#   );
#   INSERT INTO site_config (id, data) VALUES (1, '{}');
#
#   CREATE TABLE gallery_items (
#     id text PRIMARY KEY,
#     title text,
#     category text,
#     storage_path text,
#     public_url text,
#     created_at timestamptz DEFAULT now()
#   );
#
#   3. Create a storage bucket named 'gallery-images' (public)
#   4. Copy your project URL and anon key from Settings → API

